# Server Port (Auto-assigned on Heroku/Render/Railway)
PORT=5000
NODE_ENV=production

# OPTION 1: Cloud Database Connection String (Recommended for Railway / Render / Supabase / Aiven)
# DATABASE_URL=mysql://user:password@host:port/database

# OPTION 2: Individual MySQL Environment Variables (Local XAMPP or custom MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=railway_db
DB_PORT=3306
DB_SSL=false

# Authentication Secret (Change this to a random 64-character secret in production)
JWT_SECRET=railway_secret_key_2026_super_secure_jwt
